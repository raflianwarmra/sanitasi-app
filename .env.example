# Google Apps Script Web App URL for appending catatan rows to the sheet.
# See docs/DATA_FLOW_AND_SOURCES.md for the doPost snippet and deploy steps.
# If not set, catatan are stored in memory for the current session only.
VITE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: SHA-256 hex of the dashboard access code (printf '%s' 'kode' | sha256sum).
# Unset = the team's current code. Only the hash is ever built into the bundle.
# VITE_ACCESS_CODE_SHA256=
